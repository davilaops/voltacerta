# ---------------------------------------------------------------------------
# Frontend (públicas — seguras no navegador; o acesso é protegido por RLS)
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key

# Subdomínios (produção). Em desenvolvimento deixe só VITE_APP_URL=http://localhost:5173
# e acesse o admin em http://localhost:5173/admin
VITE_SITE_URL=https://voltacerta.com.br
VITE_APP_URL=https://app.voltacerta.com.br
VITE_ADMIN_URL=https://admin.voltacerta.com.br

# "production" remove o selo de ambiente de desenvolvimento
VITE_APP_ENV=development

# ---------------------------------------------------------------------------
# Backend — NUNCA no frontend nem no git. Use em .env.admin (ignorado) ou
# no terminal ao rodar `npm run admin:promote`.
# ---------------------------------------------------------------------------
# VOLTA_ADMIN_EMAIL=voce@empresa.com.br
# SUPABASE_URL=https://SEU-PROJETO.supabase.co          (opcional, alternativa ao CLI)
# SUPABASE_SERVICE_ROLE_KEY=...                          (opcional, alternativa ao CLI)
