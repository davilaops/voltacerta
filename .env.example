# Frontend (públicas — seguras para o navegador; o acesso é protegido por RLS)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key
# URL pública do app (usada em links de convite/recuperação de senha)
VITE_APP_URL=http://localhost:5173
# "development" exibe o selo "Ambiente de desenvolvimento" no painel
VITE_APP_ENV=development
